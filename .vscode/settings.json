{
    // 依赖装在 VSCode 默认解释器 D:\python-3.11.1-amd64 里
    // （numpy / pandas / matplotlib / ipykernel / pytest），
    // 所以这里不需要钉解释器路径，也不需要注入 PYTHONPATH。
    //
    // 想换解释器：右下角点击切换，任何装了 pandas + matplotlib 的都行。
    "python-envs.defaultEnvManager": "ms-python.python:system",

    // 编辑器体验
    "files.encoding": "utf8",
    "files.trimTrailingWhitespace": true,
    "[python]": {
        "editor.tabSize": 4,
        "editor.rulers": [88]
    },

    // 生成的产物不需要出现在搜索结果里
    "search.exclude": {
        "**/__pycache__": true,
        "**/data/raw": true,
        "**/.pytest_cache": true
    }
}
