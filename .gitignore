# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so

# ---- Virtual environments ----
.venv/
venv/
env/
ENV/

# ---- Test / coverage ----
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ---- Editors / OS ----
# .vscode/settings.json is tracked on purpose: it holds editor conventions
# (indent, encoding, search excludes) that are useful to share. It deliberately
# contains no interpreter path, so it stays valid on any machine.
.vscode/*
!.vscode/settings.json
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# ---- Project outputs ----
# Regenerate with: python -m src.generate
# The raw CSVs are deliberately NOT committed: they are reproducible from a
# fixed seed, and committing 500 KB of derived data makes the diff noisy.
# figures/ IS committed, because the README embeds the charts.
data/
out/

# ---- Scratch ----
scratch/
*.tmp
