# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so

# ---- Virtual environments / vendored deps ----
.venv/
venv/
env/
ENV/
# Locally vendored dependencies installed with:
#   python -m pip install --target vendor "numpy>=1.24" pandas matplotlib pytest
# Not committed: ~200 MB of wheels, and trivially reproducible from the command
# above. .vscode/settings.json injects it via PYTHONPATH.
vendor/

# ---- Test / coverage ----
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ---- Editors / OS ----
# .vscode/settings.json IS tracked on purpose: it pins the interpreter and
# PYTHONPATH this project needs on a machine with several Python installs,
# which is exactly the setup detail that is painful to rediscover later.
# It contains no secrets.
.vscode/*
!.vscode/settings.json
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# ---- Project outputs ----
# Regenerate with: python -m src.generate
# The raw CSVs are deliberately NOT committed: they are reproducible from a
# fixed seed, and committing 500 KB of derived data makes the diff noisy.
# figures/ IS committed, because the README embeds the charts.
data/
out/

# ---- Scratch ----
scratch/
*.tmp
